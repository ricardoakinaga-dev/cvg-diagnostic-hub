{
  "openapi": "3.1.0",
  "info": {
    "title": "CVG Diagnostics Hub API",
    "version": "1.0.0-local",
    "description": "Contrato local verificável da API versionada. Dados são sintéticos; políticas hospitalares e integrações externas continuam condicionais."
  },
  "servers": [{ "url": "/api/v1" }],
  "tags": [
    { "name": "health" },
    { "name": "session" },
    { "name": "diagnostics" },
    { "name": "results" },
    { "name": "operations" },
    { "name": "admin" },
    { "name": "realtime" }
  ],
  "paths": {
    "/livez": { "get": { "tags": ["health"], "operationId": "livez", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/readyz": { "get": { "tags": ["health"], "operationId": "readyz", "responses": { "200": { "$ref": "#/components/responses/Success" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/metrics": { "get": { "tags": ["health"], "operationId": "metrics", "security": [{ "session": [] }], "responses": { "200": { "description": "Prometheus text exposition" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/session/login": { "post": { "tags": ["session"], "operationId": "login", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/session/me": { "get": { "tags": ["session"], "operationId": "sessionMe", "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/session/logout": { "post": { "tags": ["session"], "operationId": "logout", "security": [{ "session": ["csrf"] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/session/reauth": { "post": { "tags": ["session"], "operationId": "sessionReauth", "security": [{ "session": ["csrf"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["password"], "properties": { "password": { "type": "string", "minLength": 1, "maxLength": 200 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/users": { "get": { "$ref": "#/components/operations/read" }, "post": { "tags": ["admin"], "operationId": "createManagedUser", "security": [{ "session": ["csrf"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManagedUserCreate" } } } }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/users/{userId}/roles": { "post": { "tags": ["admin"], "operationId": "updateUserRole", "security": [{ "session": ["csrf"] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserRoleUpdate" } } } }, "responses": { "200": { "description": "Role versionada e auditada", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ManagedUser" } } }] } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/users/{userId}": { "delete": { "tags": ["admin"], "operationId": "deactivateManagedUser", "security": [{ "session": ["csrf"] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManagedUserDeactivate" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/diagnostic-services": { "get": { "$ref": "#/components/operations/read" }, "post": { "$ref": "#/components/operations/command" } },
    "/diagnostic-services/{serviceId}": { "patch": { "$ref": "#/components/operations/command" } },
    "/reason-codes": { "get": { "$ref": "#/components/operations/read" }, "post": { "$ref": "#/components/operations/command" } },
    "/reason-codes/{reasonCodeId}": { "patch": { "$ref": "#/components/operations/command" } },
    "/patients": { "get": { "$ref": "#/components/operations/read" } },
    "/patients/{patientId}": { "get": { "$ref": "#/components/operations/read" } },
    "/patients/{patientId}/diagnostics": { "get": { "$ref": "#/components/operations/read" } },
    "/patients/{patientId}/encounters": { "get": { "$ref": "#/components/operations/read" } },
    "/encounters/{encounterId}": { "get": { "$ref": "#/components/operations/read" } },
    "/admissions/{admissionId}": { "get": { "$ref": "#/components/operations/read" } },
    "/diagnostic-requests": { "get": { "tags": ["diagnostics"], "operationId": "listDiagnosticRequests", "security": [{ "session": [] }], "parameters": [{ "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/DepartmentCode" }, { "$ref": "#/components/parameters/Priority" }, { "$ref": "#/components/parameters/ServiceId" }, { "$ref": "#/components/parameters/Overdue" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }, "post": { "$ref": "#/components/operations/command" } },
    "/diagnostic-requests/{requestId}": { "get": { "$ref": "#/components/operations/read" } },
    "/diagnostic-requests/{requestId}/cancel": { "post": { "$ref": "#/components/operations/command" } },
    "/diagnostic-items/{itemId}": { "get": { "$ref": "#/components/operations/read" } },
    "/diagnostic-items/{itemId}/{action}": { "post": { "$ref": "#/components/operations/command" } },
    "/samples/{sampleId}/receive-replacement": { "post": { "$ref": "#/components/operations/command" } },
    "/procedures/{procedureId}/reschedule": { "post": { "$ref": "#/components/operations/command" } },
    "/result-versions/{versionId}/attachments/upload-session": { "post": { "$ref": "#/components/operations/command" } },
    "/attachments/{attachmentId}/content": { "put": { "$ref": "#/components/operations/command" } },
    "/attachments/{attachmentId}/finalize": { "post": { "$ref": "#/components/operations/command" } },
    "/attachments/{attachmentId}/download": { "get": { "$ref": "#/components/operations/read" } },
    "/results/{resultId}": { "get": { "$ref": "#/components/operations/read" } },
    "/results/{resultId}/versions": { "get": { "$ref": "#/components/operations/read" } },
    "/results/{resultId}/draft": { "patch": { "$ref": "#/components/operations/command" } },
    "/results/{resultId}/release": { "post": { "$ref": "#/components/operations/command" } },
    "/results/{resultId}/amend": { "post": { "$ref": "#/components/operations/command" } },
    "/results/{resultId}/void": { "post": { "$ref": "#/components/operations/command" } },
    "/results/{resultId}/view": { "post": { "$ref": "#/components/operations/command" } },
    "/results/{resultId}/review": { "post": { "$ref": "#/components/operations/command" } },
    "/reports/{reportId}": { "get": { "$ref": "#/components/operations/read" } },
    "/notifications": { "get": { "$ref": "#/components/operations/read" } },
    "/notifications/{notificationId}/acknowledge": { "post": { "tags": ["operations"], "operationId": "acknowledgeNotification", "security": [{ "session": ["csrf"] }], "parameters": [{ "name": "notificationId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }, { "$ref": "#/components/parameters/IdempotencyKeyRequired" }, { "$ref": "#/components/parameters/CsrfToken" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationAcknowledge" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/queues/{departmentCode}/items": { "get": { "$ref": "#/components/operations/read" } },
    "/search": { "get": { "tags": ["operations"], "operationId": "search", "security": [{ "session": [] }], "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }, { "$ref": "#/components/parameters/SearchTypes" }, { "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/DepartmentCode" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/timeline": { "get": { "tags": ["operations"], "operationId": "timeline", "security": [{ "session": [] }], "parameters": [{ "name": "requestId", "in": "query", "schema": { "type": "string", "minLength": 1 } }, { "name": "itemId", "in": "query", "schema": { "type": "string", "minLength": 1 } }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/audit-events": { "get": { "$ref": "#/components/operations/read" } },
    "/dashboard": { "get": { "tags": ["operations"], "operationId": "dashboard", "security": [{ "session": [] }], "responses": { "200": { "description": "Indicadores operacionais no escopo autorizado", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/DashboardView" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/management/overview": { "get": { "tags": ["operations"], "operationId": "managementOverview", "security": [{ "session": [] }], "responses": { "200": { "description": "Snapshot operacional delegado por setor", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ManagementOverview" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/realtime/events": { "get": { "tags": ["realtime"], "operationId": "realtimeEvents", "security": [{ "session": [] }], "responses": { "200": { "description": "SSE stream with replay and resync_required" }, "404": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "session": { "type": "apiKey", "in": "cookie", "name": "cvg_session", "description": "Opaque HttpOnly session cookie; mutating methods also require cvg_csrf and x-csrf-token." } },
    "parameters": {
      "CsrfToken": { "name": "x-csrf-token", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 }, "description": "CSRF double-submit token for cookie-authenticated mutations." },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "IdempotencyKeyRequired": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "IfMatch": { "name": "If-Match", "in": "header", "required": false, "schema": { "type": "string", "pattern": "^(W/)?\\\"?[1-9][0-9]*\\\"?$" }, "description": "Optional optimistic version; expectedVersion in JSON takes precedence when both are supplied." },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" } },
      "Status": { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["REQUESTED", "RECEIVED", "IN_PROGRESS", "SCHEDULED", "AWAITING_REPORT", "RESULT_AVAILABLE", "REVIEWED", "COMPLETED", "CANCELLED", "REJECTED", "RECOLLECTION_REQUIRED", "FAILED", "RESULT_VOIDED"] } },
      "Priority": { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["ROUTINE", "URGENT", "EMERGENCY"] } },
      "DepartmentCode": { "name": "departmentCode", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 60 } },
      "ServiceId": { "name": "serviceId", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
      "Overdue": { "name": "overdue", "in": "query", "schema": { "type": "boolean" } },
      "From": { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "To": { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "SearchQuery": { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 200 } },
      "SearchTypes": { "name": "types", "in": "query", "schema": { "type": "string", "pattern": "^(REQUEST|ITEM)(,(REQUEST|ITEM))?$" } }
    },
    "requestBodies": { "JsonObject": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } },
    "schemas": {
      "SuccessEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": {}, "meta": { "type": "object", "required": ["requestId", "correlationId"], "properties": { "requestId": { "type": "string" }, "correlationId": { "type": "string" }, "nextCursor": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } } } } },
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "correlationId"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "object" }, "correlationId": { "type": "string" } } } } },
      "DashboardWindow": { "type": "object", "required": ["kind", "label", "timezone", "asOf"], "properties": { "kind": { "const": "CURRENT_STATE" }, "label": { "const": "Estado atual" }, "timezone": { "type": "string", "minLength": 1 }, "asOf": { "type": "string", "format": "date-time" } } },
      "DashboardIndicator": { "type": "object", "required": ["key", "label", "count", "denominator", "denominatorDefinition", "definition", "nextAction"], "properties": { "key": { "type": "string", "enum": ["overdue", "recollections", "newResults", "critical", "totalActive"] }, "label": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 0 }, "denominatorDefinition": { "type": "string" }, "definition": { "type": "string" }, "nextAction": { "type": "string" } } },
      "DashboardView": { "type": "object", "required": ["overdue", "recollections", "newResults", "critical", "totalActive", "updatedAt", "window", "indicators"], "properties": { "overdue": { "type": "integer", "minimum": 0 }, "recollections": { "type": "integer", "minimum": 0 }, "newResults": { "type": "integer", "minimum": 0 }, "critical": { "type": "integer", "minimum": 0 }, "totalActive": { "type": "integer", "minimum": 0 }, "updatedAt": { "type": "string", "format": "date-time" }, "window": { "$ref": "#/components/schemas/DashboardWindow" }, "indicators": { "type": "array", "minItems": 5, "items": { "$ref": "#/components/schemas/DashboardIndicator" } } } },
      "RoleCode": { "type": "string", "enum": ["ADMIN", "MANAGER", "VETERINARIAN", "INPATIENT_TEAM", "LAB_TECH", "RADIOLOGY_TEAM", "ULTRASOUND_TEAM", "VIEWER"] },
      "ManagedUser": { "type": "object", "additionalProperties": false, "required": ["id", "email", "displayName", "role", "departmentCode", "active", "timezone", "createdAt", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "email": { "type": "string", "format": "email" }, "displayName": { "type": "string" }, "role": { "$ref": "#/components/schemas/RoleCode" }, "departmentCode": { "type": "string", "minLength": 1, "maxLength": 60 }, "managedDepartmentCodes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 60 } }, "active": { "type": "boolean" }, "timezone": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }, "version": { "type": "integer", "minimum": 1 } } },
      "ManagedUserCreate": { "type": "object", "additionalProperties": false, "required": ["email", "displayName", "password", "role", "departmentCode", "timezone", "reason", "confirm"], "properties": { "email": { "type": "string", "format": "email", "maxLength": 320 }, "displayName": { "type": "string", "minLength": 2, "maxLength": 160 }, "password": { "type": "string", "minLength": 12, "maxLength": 200 }, "role": { "$ref": "#/components/schemas/RoleCode" }, "departmentCode": { "type": "string", "minLength": 1, "maxLength": 60 }, "managedDepartmentCodes": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }, "timezone": { "type": "string", "minLength": 1, "maxLength": 80 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "confirm": { "const": true } } },
      "ManagedUserDeactivate": { "type": "object", "additionalProperties": false, "required": ["expectedVersion", "reason", "confirm"], "properties": { "expectedVersion": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "confirm": { "const": true } } },
      "DiagnosticServicePatch": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "category": { "type": "string", "enum": ["LABORATORY", "IMAGING"] }, "departmentCode": { "type": "string", "minLength": 1, "maxLength": 60 }, "workflowType": { "type": "string", "enum": ["LABORATORY", "RADIOLOGY", "ULTRASOUND"] }, "requiresSample": { "type": "boolean" }, "requiresSchedule": { "type": "boolean" }, "active": { "type": "boolean" }, "allowsAttachment": { "type": "boolean" }, "resultSchema": { "type": "string", "enum": ["NUMERIC_PANEL", "NARRATIVE"] }, "slaHours": { "$ref": "#/components/schemas/SlaHours" }, "expectedVersion": { "type": "integer", "minimum": 1 } } },
      "SlaHours": { "type": "object", "additionalProperties": false, "required": ["ROUTINE", "URGENT", "EMERGENCY"], "properties": { "ROUTINE": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 }, "URGENT": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 }, "EMERGENCY": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 } } },
      "ManagementOverview": { "type": "object", "additionalProperties": false, "required": ["asOf", "scope", "summary", "departments", "pending", "recentRequests"], "properties": { "asOf": { "type": "string", "format": "date-time" }, "scope": { "type": "object", "required": ["departments", "label"], "properties": { "departments": { "type": "array", "items": { "type": "string" } }, "label": { "type": "string" } } }, "summary": { "type": "object", "required": ["totalRequests", "activeItems", "overdue", "recollections", "newResults", "critical", "pendingRequests", "completedToday"], "properties": { "totalRequests": { "type": "integer", "minimum": 0 }, "activeItems": { "type": "integer", "minimum": 0 }, "overdue": { "type": "integer", "minimum": 0 }, "recollections": { "type": "integer", "minimum": 0 }, "newResults": { "type": "integer", "minimum": 0 }, "critical": { "type": "integer", "minimum": 0 }, "pendingRequests": { "type": "integer", "minimum": 0 }, "completedToday": { "type": "integer", "minimum": 0 } } }, "departments": { "type": "array", "items": { "type": "object", "required": ["departmentCode", "serviceCount", "totalRequests", "activeItems", "overdue", "pending"], "properties": { "departmentCode": { "type": "string" }, "serviceCount": { "type": "integer", "minimum": 0 }, "totalRequests": { "type": "integer", "minimum": 0 }, "activeItems": { "type": "integer", "minimum": 0 }, "overdue": { "type": "integer", "minimum": 0 }, "pending": { "type": "integer", "minimum": 0 } } } }, "pending": { "type": "array", "items": { "type": "object", "required": ["id", "requestId", "requestCode", "patient", "service", "departmentCode", "status", "priority", "dueAt", "overdue", "nextAction", "deepLink"], "properties": { "id": { "type": "string" }, "requestId": { "type": "string" }, "requestCode": { "type": "string" }, "patient": { "type": "string" }, "service": { "type": "string" }, "departmentCode": { "type": "string" }, "status": { "type": "string" }, "priority": { "type": "string", "enum": ["ROUTINE", "URGENT", "EMERGENCY"] }, "dueAt": { "type": "string", "format": "date-time" }, "overdue": { "type": "boolean" }, "nextAction": { "type": "string" }, "deepLink": { "type": "string" } } } }, "recentRequests": { "type": "array", "items": { "type": "object", "required": ["id", "requestCode", "patient", "aggregateStatus", "priority", "updatedAt", "itemCount", "deepLink"], "properties": { "id": { "type": "string" }, "requestCode": { "type": "string" }, "patient": { "type": "string" }, "aggregateStatus": { "type": "string" }, "priority": { "type": "string", "enum": ["ROUTINE", "URGENT", "EMERGENCY"] }, "updatedAt": { "type": "string", "format": "date-time" }, "itemCount": { "type": "integer", "minimum": 0 }, "deepLink": { "type": "string" } } } } } },
      "UserRoleUpdate": { "type": "object", "additionalProperties": false, "required": ["role", "departmentCode", "expectedVersion", "reason", "confirm"], "properties": { "role": { "$ref": "#/components/schemas/RoleCode" }, "departmentCode": { "type": "string", "minLength": 1, "maxLength": 60 }, "managedDepartmentCodes": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }, "active": { "type": "boolean" }, "expectedVersion": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "confirm": { "const": true } } },
      "NotificationAcknowledge": { "type": "object", "additionalProperties": false, "required": ["expectedVersion", "reason", "confirm"], "properties": { "expectedVersion": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "confirm": { "const": true } } }
    },
    "responses": {
      "Success": { "description": "Envelope de sucesso", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
      "Error": { "description": "Envelope de erro seguro", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "operations": {
      "read": { "security": [{ "session": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
