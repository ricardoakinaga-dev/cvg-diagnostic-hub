NODE_ENV=development
APP_DATA_MODE=memory
DEMO_PASSWORD=replace-with-a-unique-synthetic-password
ALLOW_SYNTHETIC_SEED=false
ALLOW_DB_SMOKE_RESET=false
JSON_BODY_MAX_BYTES=1048576
JSON_BODY_MAX_DEPTH=32
APP_PORT=3000
DATABASE_URL=postgresql://cvg:cvg_dev@localhost:54329/cvg_diagnostics
DB_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
STORAGE_MODE=local
STORAGE_ROOT=.data/uploads
STORAGE_SCAN_MODE=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cvg-attachments
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_UPLOAD_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10
TRUST_PROXY=false
REALTIME_STREAM_MAX_MS=0
CRITICAL_POLICY_ENABLED=false
CRITICAL_POLICY_VERSION=
CRITICAL_POLICY_APPROVAL_REF=
CRITICAL_POLICY_APPROVED_AT=
